# Configurações do Servidor
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Banco de Dados PostgreSQL
# Se DATABASE_URL estiver definida, o Zero Control usa PostgreSQL (ex: Supabase, Docker, Cloud SQL).
# Se DATABASE_URL estiver vazia ou omitida, o Zero Control usa PGlite embutido no diretório data/pglite.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zerocontrol

# Segurança e Sessão
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-in-production
CSRF_SECRET=change-this-to-a-secure-random-32-byte-secret-for-csrf

# Armazenamento e Arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_AVATAR_MB=5
MAX_FILE_SIZE_POST_MB=8
